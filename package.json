{
  "name": "ruri-webgpu",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:extension": "vite build -c extension/vite.config.ts",
    "zip:extension": "npm run build:extension && (cd dist-extension && zip -r ../ruri-webgpu-chrome-extension.zip .) && ls -lh ruri-webgpu-chrome-extension.zip",
    "release": "node scripts/release.js",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@huggingface/tokenizers": "^0.2.0",
    "onnxruntime-web": "^1.21.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.2",
    "@types/puppeteer": "^7.0.4",
    "coi-serviceworker": "^0.1.7",
    "jsdom": "^29.1.1",
    "puppeteer": "^25.11.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^5.0.1"
  }
}
