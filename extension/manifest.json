{
  "manifest_version": 3,
  "name": "ruri-webgpu 意味検索",
  "version": "0.2.0",
  "description": "閲覧中のWebページ内を Cmd+F のようにセマンティック（意味）＆ハイブリッドでストリーム検索・ハイライトする拡張機能",
  "permissions": [
    "offscreen",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "検索オーバーレイを開く"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "Command+Shift+F"
      },
      "description": "セマンティック検索バーを開閉する"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/overlay.css",
        "assets/ort/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
